# Copy to .env.production (git-ignored) and fill in. Used by `task prod_check` / `task prod_up`.
# Keep comments on their own lines: compose treats trailing text after an empty value as the value.
# Loaded after .env.project, which sets COMPOSE_PROJECT_NAME and the image prefixes from brand.toml.
APP_ENV=production
# Neo4j Community. For Enterprise use neo4j:2026.06.0-enterprise and NEO4J_LICENSE=yes, which
# requires a commercial Neo4j Enterprise licence
NEO4J_IMAGE=neo4j:2026.06.0
NEO4J_LICENSE=
# Strong, unique, from your secret store
NEO4J_PASSWORD=
NEO4J_HEAP=4G
NEO4J_PAGECACHE=4G
# e.g. anthropic:claude-sonnet-4-5 (add the matching pydantic-ai-slim extra) + its API key
LLM_MODEL=test
ANTHROPIC_API_KEY=
# The release workflow's images (ghcr.io/<owner>/<repo> from brand.toml); IMAGE_TAG = latest or a promoted vX.Y.Z
IMAGE_PREFIX=${RELEASE_IMAGE_PREFIX}
IMAGE_TAG=latest
# Put a reverse proxy / TLS in front of the UI
UI_BIND=0.0.0.0
MOBILE_BIND=0.0.0.0
DOCS_BIND=0.0.0.0
# Public address of the docs portal; the web UI and mobile app link to it. Empty hides the link
DOCS_URL=https://docs.example.com
# Sign-on. "mock" is refused in production unless AUTH_ALLOW_MOCK=true (a public demo);
# "off" lets anyone write. Tokens are signed with AUTH_SECRET: long, random, from your secret store
AUTH_MODE=off
AUTH_SECRET=
AUTH_ALLOW_MOCK=false
# JSON list of origins allowed to call the API directly (native Capacitor builds); the
# mobile web image proxies /api itself and needs none
CORS_ORIGINS=["capacitor://localhost","https://localhost"]
