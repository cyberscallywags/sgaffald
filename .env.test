# Test environment. Committed on purpose: throwaway values only, never real secrets.
# Loaded after .env.project (project identity, generated from brand.toml).
# A separate compose project, so `task down -v` never touches a production stack's volumes
COMPOSE_PROJECT_NAME=${PROJECT_SLUG:?load .env.project first, e.g. uv run task up}-test
APP_ENV=test
NEO4J_IMAGE=neo4j:2026.06.0-enterprise
NEO4J_LICENSE=eval
NEO4J_PASSWORD=sgaffald-test-only
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M
LLM_MODEL=test
IMAGE_TAG=local
UI_BIND=127.0.0.1
MOBILE_BIND=127.0.0.1
DOCS_BIND=127.0.0.1
# Docs portal address the web UI and mobile app link to
DOCS_URL=http://localhost:8200
# Native (Capacitor) app origins allowed to call the API directly
CORS_ORIGINS=["capacitor://localhost","ionic://localhost","http://localhost"]

# Used by integration + load tests running on the host
API_URL=http://localhost:8000
UI_URL=http://localhost:8080
ADMIN_URL=http://localhost:8501
MOBILE_URL=http://localhost:8100
NEO4J_URI=bolt://localhost:7687
